generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int       @id @default(autoincrement())
  email                    String    @unique
  username                 String?
  name                     String?
  password                 String
  role                     String    @default("USER")
  canAccessEmployees       Boolean   @default(false)
  accessiblePages          String[]  @default(["/dashboard", "/tasks", "/settings"])
  emailVerified            Boolean   @default(true)
  verificationTokenHash    String?   @unique
  verificationTokenExpires DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  posts                    Post[]
  tasks                    Task[]
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
}

model Task {
  id                Int                    @id @default(autoincrement())
  title             String
  description       String?
  status            String                 @default("PENDING")
  priority          String                 @default("MEDIUM")
  category          String?
  notes             String?
  recurrence        String                 @default("NONE")
  recurrenceAnchor  DateTime?
  isFlagged         Boolean                @default(false)
  dueDate           DateTime?
  sortOrder         Int                    @default(0)
  userId            Int
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rescheduleHistory TaskReschedule[]
  prerequisiteLinks TaskDependency[]       @relation("BlockedTask")
  prerequisiteFor   TaskDependency[]       @relation("PrerequisiteTask")
  prerequisiteItems TaskPrerequisiteItem[]

  @@index([userId, status])
}

model TaskReschedule {
  id              Int       @id @default(autoincrement())
  taskId          Int
  previousDueDate DateTime?
  newDueDate      DateTime?
  reason          String
  createdAt       DateTime  @default(now())
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskDependency {
  blockedTaskId      Int
  prerequisiteTaskId Int
  blockedTask        Task @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  prerequisiteTask   Task @relation("PrerequisiteTask", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)

  @@id([blockedTaskId, prerequisiteTaskId])
  @@index([prerequisiteTaskId])
}

model TaskPrerequisiteItem {
  id          Int       @id @default(autoincrement())
  taskId      Int
  title       String
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model employee {
  id                Int               @id @default(autoincrement())
  status            String?
  dateStarted       DateTime?
  employerId        Int?
  address           String?
  age               Int?
  biometricNo       String?           @unique
  branch            String?
  position          String?
  createdAt         DateTime          @default(now())
  dateOfBirth       DateTime?
  email             String?
  emergencyAddress  String?
  emergencyName     String?
  emergencyNumber   String?
  emergencyRelation String?
  employeeCode      String            @unique
  endDate           DateTime?
  firstName         String
  gender            String?
  jobLevel          String?
  lastName          String
  maritalStatus     String?
  middleName        String?
  mobileNumber      String?
  pagIbigNumber     String?
  philHealth        String?
  photoUrl          String?
  remarks           String?
  sssNumber         String?
  tinNumber         String?
  updatedAt         DateTime          @updatedAt
  supervisorId      Int?
  assignedBy        String?
  assignedAt        DateTime?
  employer          employer?         @relation(fields: [employerId], references: [id])
  supervisor        employee?         @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  directReports     employee[]        @relation("EmployeeSupervisor")
  attendanceRecords Attendance[]
  attendancePunches AttendancePunch[]
  officeContacts    OfficeContact[]
  requirements      EmployeeRequirement[]

  @@index([employerId])
  @@index([supervisorId])
}

model EmployeeRequirement {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  requirementKey  String
  isComplete      Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  employee        employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, requirementKey])
  @@index([employeeId, isComplete])
}

model EmployeeCategory {
  id        Int      @id @default(autoincrement())
  type      String
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, name])
  @@index([type, active, sortOrder])
}

model Attendance {
  id         Int               @id @default(autoincrement())
  employeeId Int
  date       DateTime          @db.Date
  timeIn     String?
  timeOut    String?
  status     String
  branch     String?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  employee   employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  punches    AttendancePunch[]

  @@unique([employeeId, date])
  @@index([date, status])
}

model AttendanceImport {
  id            Int               @id @default(autoincrement())
  branch        String
  fileName      String
  totalRows     Int
  importedRows  Int
  duplicateRows Int
  unmatchedRows Int
  createdAt     DateTime          @default(now())
  punches       AttendancePunch[]

  @@index([createdAt])
}

model AttendancePunch {
  id           Int              @id @default(autoincrement())
  employeeId   Int
  attendanceId Int
  importId     Int
  date         DateTime         @db.Date
  time         String
  deviceNumber String
  branch       String
  createdAt    DateTime         @default(now())
  employee     employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance   Attendance       @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  importBatch  AttendanceImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date, time, deviceNumber, branch])
  @@index([date, branch])
  @@index([attendanceId, time])
}

model employer {
  id                     Int        @id @default(autoincrement())
  name                   String
  company                String?
  branches               String?
  status                 String     @default("Active")
  email                  String?
  contactNumber          String?
  branchStatus           String     @default("Open")
  president              String?
  longAddress            String?
  shortAddress           String?
  logo                   String?
  secDti                 String?    @unique
  secDtiRegistrationDate DateTime?
  tin                    String?
  tinRegistrationDate    DateTime?
  sss                    String?
  sssRegistrationDate    DateTime?
  hdmf                   String?
  hdmfRegistrationDate   DateTime?
  phic                   String?
  phicRegistrationDate   DateTime?
  employees              employee[]
}

model OfficeContact {
  id          Int       @id @default(autoincrement())
  employeeId  Int?
  companyName String
  contactName String
  category    String
  phone       String?
  email       String?
  address     String?
  services    String?
  branch      String?
  notes       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([category, active])
  @@index([companyName])
  @@index([employeeId])
}
