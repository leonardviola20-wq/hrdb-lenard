generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int              @id @default(autoincrement())
  email                    String           @unique
  username                 String?
  name                     String?
  password                 String
  role                     String           @default("USER")
  canAccessEmployees       Boolean          @default(false)
  accessiblePages          String[]         @default(["/dashboard", "/tasks", "/settings"])
  emailVerified            Boolean          @default(true)
  verificationTokenHash    String?          @unique
  verificationTokenExpires DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  posts                    Post[]
  tasks                    Task[]
  sssReportDrafts          SssReportDraft[]
  sssReports               SssReport[]
  PagibigReport            PagibigReport[]
  PagibigReportDraft       PagibigReportDraft[]
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
}

model Task {
  id                Int                    @id @default(autoincrement())
  title             String
  description       String?
  status            String                 @default("PENDING")
  priority          String                 @default("MEDIUM")
  category          String?
  notes             String?
  recurrence        String                 @default("NONE")
  recurrenceAnchor  DateTime?
  isFlagged         Boolean                @default(false)
  dueDate           DateTime?
  sortOrder         Int                    @default(0)
  userId            Int
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rescheduleHistory TaskReschedule[]
  prerequisiteLinks TaskDependency[]       @relation("BlockedTask")
  prerequisiteFor   TaskDependency[]       @relation("PrerequisiteTask")
  prerequisiteItems TaskPrerequisiteItem[]

  @@index([userId, status])
}

model TaskReschedule {
  id              Int       @id @default(autoincrement())
  taskId          Int
  previousDueDate DateTime?
  newDueDate      DateTime?
  reason          String
  createdAt       DateTime  @default(now())
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskDependency {
  blockedTaskId      Int
  prerequisiteTaskId Int
  blockedTask        Task @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  prerequisiteTask   Task @relation("PrerequisiteTask", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)

  @@id([blockedTaskId, prerequisiteTaskId])
  @@index([prerequisiteTaskId])
}

model TaskPrerequisiteItem {
  id          Int       @id @default(autoincrement())
  taskId      Int
  title       String
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model employee {
  id                     Int                             @id @default(autoincrement())
  status                 String?
  dateStarted            DateTime?
  employerId             Int?
  address                String?
  age                    Int?
  biometricNo            String?                         @unique
  branch                 String?
  position               String?
  createdAt              DateTime                        @default(now())
  dateOfBirth            DateTime?
  email                  String?
  emergencyAddress       String?
  emergencyName          String?
  emergencyNumber        String?
  emergencyRelation      String?
  employeeCode           String                          @unique
  endDate                DateTime?
  firstName              String
  gender                 String?
  jobLevel               String?
  lastName               String
  maritalStatus          String?
  middleName             String?
  mobileNumber           String?
  pagIbigNumber          String?
  philHealth             String?
  photoUrl               String?
  remarks                String?
  sssNumber              String?
  tinNumber              String?
  updatedAt              DateTime                        @updatedAt
  supervisorId           Int?
  assignedBy             String?
  assignedAt             DateTime?
  employer               employer?                       @relation(fields: [employerId], references: [id])
  supervisor             employee?                       @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  directReports          employee[]                      @relation("EmployeeSupervisor")
  attendanceRecords      Attendance[]
  attendancePunches      AttendancePunch[]
  officeContacts         OfficeContact[]
  requirements           EmployeeRequirement[]
  requirementAttachments EmployeeRequirementAttachment[]
  bdoAccountNumbers      EmployeeBdoAccountNumber[]
  sssReportEntries       SssReportEntry[]
  sssLoans               SssLoan[]
  pagibigEmployeeRecords PagibigEmployeeRecord[]
  pagibigReportEntries   PagibigReportEntry[]
  pagibigLoans           PagibigLoan[]
  requirementsBypassed   Boolean                         @default(false)

  @@index([employerId])
  @@index([supervisorId])
}

model EmployeeRequirement {
  id             Int                             @id @default(autoincrement())
  employeeId     Int
  requirementKey String
  isComplete     Boolean                         @default(false)
  updatedAt      DateTime                        @updatedAt
  employee       employee                        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attachments    EmployeeRequirementAttachment[]

  @@unique([employeeId, requirementKey])
  @@index([employeeId, isComplete])
}

model EmployeeRequirementAttachment {
  id                    Int                 @id @default(autoincrement())
  employeeId            Int
  requirementKey        String
  employeeRequirementId Int
  fileName              String
  mimeType              String
  size                  Int
  content               Bytes
  createdAt             DateTime            @default(now())
  employee              employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeRequirement   EmployeeRequirement @relation(fields: [employeeRequirementId], references: [id], onDelete: Cascade)

  @@index([employeeId, requirementKey])
  @@index([employeeRequirementId])
}

model EmployeeBdoAccountNumber {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  accountNumber String
  createdAt     DateTime @default(now())
  employee      employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, accountNumber])
  @@index([employeeId])
}

model EmployeeCategory {
  id        Int      @id @default(autoincrement())
  type      String
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, name])
  @@index([type, active, sortOrder])
}

model Attendance {
  id         Int               @id @default(autoincrement())
  employeeId Int
  date       DateTime          @db.Date
  timeIn     String?
  timeOut    String?
  status     String
  branch     String?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  employee   employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  punches    AttendancePunch[]

  @@unique([employeeId, date])
  @@index([date, status])
}

model AttendanceImport {
  id            Int               @id @default(autoincrement())
  branch        String
  fileName      String
  totalRows     Int
  importedRows  Int
  duplicateRows Int
  unmatchedRows Int
  createdAt     DateTime          @default(now())
  punches       AttendancePunch[]

  @@index([createdAt])
}

model AttendancePunch {
  id           Int              @id @default(autoincrement())
  employeeId   Int
  attendanceId Int
  importId     Int
  date         DateTime         @db.Date
  time         String
  deviceNumber String
  branch       String
  createdAt    DateTime         @default(now())
  employee     employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance   Attendance       @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  importBatch  AttendanceImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date, time, deviceNumber, branch])
  @@index([date, branch])
  @@index([attendanceId, time])
}

model employer {
  id                     Int         @id @default(autoincrement())
  name                   String
  company                String?
  branches               String?
  status                 String      @default("Active")
  email                  String?
  contactNumber          String?
  branchStatus           String      @default("Open")
  president              String?
  longAddress            String?
  shortAddress           String?
  logo                   String?
  secDti                 String?     @unique
  secDtiRegistrationDate DateTime?
  tin                    String?
  tinRegistrationDate    DateTime?
  sss                    String?
  sssRegistrationDate    DateTime?
  hdmf                   String?
  hdmfRegistrationDate   DateTime?
  phic                   String?
  phicRegistrationDate   DateTime?
  employees              employee[]
  sssReports             SssReport[]
  sssLoans               SssLoan[]
  pagibigEmployeeLoans   PagibigEmployeeLoan[]
  pagibigEmployeeRecords PagibigEmployeeRecord[]
  pagibigLoans           PagibigLoan[]
  pagibigReports         PagibigReport[]
}

model SssLoan {
  id                  Int              @id @default(autoincrement())
  employerId          Int
  employeeId          Int?
  employeeName        String
  employeeCode        String
  biometricNo         String
  loanAccountNumber   String
  transactionNumber   String?
  loanType            String           @default("S")
  loanDate            DateTime         @db.Date
  loanAmount          Decimal?         @db.Decimal(12, 2)
  monthlyAmortization Decimal          @db.Decimal(12, 2)
  status              String           @default("ACTIVE")
  statusReason        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  employer            employer         @relation(fields: [employerId], references: [id], onDelete: Restrict)
  employee            employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  reportEntries       SssReportEntry[]

  @@index([employerId, loanDate])
  @@index([employeeId, loanDate])
}

model SssReport {
  id                   Int              @id @default(autoincrement())
  kind                 String
  employerId           Int
  employerName         String
  employerAddress      String?
  employerSssNumber    String?
  prn                  String
  applicableMonth      Int
  applicableYear       Int
  amountDue            Decimal          @db.Decimal(12, 2)
  amountPaid           Decimal?         @db.Decimal(12, 2)
  paymentType          String?
  payDate              DateTime?        @db.Date
  sssBranch            String?
  transactionReference String?
  createdBy            Int?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  employer             employer         @relation(fields: [employerId], references: [id], onDelete: Restrict)
  creator              User?            @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  entries              SssReportEntry[]

  @@index([employerId, applicableYear, applicableMonth])
  @@index([kind, createdAt])
}

model SssReportEntry {
  id                   Int       @id @default(autoincrement())
  reportId             Int
  employeeId           Int?
  employeeName         String
  employeeCode         String
  employeeSssNumber    String?
  sssLoanId            Int?
  loanAccountNumber    String?
  employeeEmployerId   Int?
  employeeEmployerName String?
  salaryRange          String?
  monthlySalaryCredit  Decimal?  @db.Decimal(12, 2)
  employeeSs           Decimal   @default(0) @db.Decimal(12, 2)
  employerSs           Decimal   @default(0) @db.Decimal(12, 2)
  employeeMpf          Decimal   @default(0) @db.Decimal(12, 2)
  employerMpf          Decimal   @default(0) @db.Decimal(12, 2)
  ec                   Decimal   @default(0) @db.Decimal(12, 2)
  loanAmount           Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal   @db.Decimal(12, 2)
  report               SssReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  employee             employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sssLoan              SssLoan?  @relation(fields: [sssLoanId], references: [id], onDelete: SetNull)

  @@index([employeeId, reportId])
  @@index([sssLoanId])
}

model SssReportDraft {
  id              Int       @id @default(autoincrement())
  createdBy       Int
  kind            String
  employerId      Int?
  prn             String    @default("")
  applicableMonth Int       @default(1)
  applicableYear  Int
  amountDue       String    @default("")
  entries         Json
  continuedBy     Int?
  continuedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  creator         User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy, updatedAt])
  @@index([continuedBy, updatedAt])
}

model PagibigEmployeeLoan {
  id                    Int                   @id @default(autoincrement())
  recordId              Int
  employerId            Int
  loanType              String
  applicationNo         String
  loanTermDate          DateTime              @db.Date
  termYears             Int
  termEndDate           DateTime              @db.Date
  amount                Decimal?              @db.Decimal(12, 2)
  status                String                @default("INACTIVE")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime
  employer              employer              @relation(fields: [employerId], references: [id])
  PagibigEmployeeRecord PagibigEmployeeRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([employerId, loanType, applicationNo])
  @@unique([recordId, loanType])
  @@index([employerId, loanTermDate])
  @@index([recordId])
}

model PagibigEmployeeRecord {
  id                 Int                   @id @default(autoincrement())
  employeeId         Int
  employerId         Int
  year               Int
  eeShare            Decimal               @default(200) @db.Decimal(12, 2)
  erShare            Decimal               @default(200) @db.Decimal(12, 2)
  mp2AccountNo       String?
  mp2Amount          Decimal               @default(0) @db.Decimal(12, 2)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime
  excludedFromReport Boolean               @default(false)
  PagibigEmployeeLoan PagibigEmployeeLoan[]
  employee           employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employer           employer              @relation(fields: [employerId], references: [id])

  @@unique([employeeId, employerId, year])
  @@index([employerId, year])
}

model PagibigLoan {
  id                  Int                  @id @default(autoincrement())
  employerId          Int
  employeeId          Int
  employeeName        String
  employeeCode        String
  applicationNo       String
  transactionNumber   String?
  loanType            String
  loanDate            DateTime             @db.Date
  loanAmount          Decimal?             @db.Decimal(12, 2)
  monthlyAmortization Decimal              @db.Decimal(12, 2)
  status              String               @default("ACTIVE")
  statusReason        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime
  employee            employee             @relation(fields: [employeeId], references: [id])
  employer            employer             @relation(fields: [employerId], references: [id])
  PagibigReportEntry  PagibigReportEntry[]

  @@unique([employerId, applicationNo])
  @@index([employeeId, loanDate])
  @@index([employerId, loanDate])
}

model PagibigReport {
  id                    Int                  @id @default(autoincrement())
  kind                  String
  employerId            Int
  employerName          String
  employerPagibigNumber String?
  pin                   String
  applicableMonth       Int
  applicableYear        Int
  amountDue             Decimal              @db.Decimal(12, 2)
  amountPaid            Decimal?             @db.Decimal(12, 2)
  paymentType           String?
  payDate               DateTime?            @db.Date
  transactionReference  String?
  createdBy             Int?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime
  User                  User?                @relation(fields: [createdBy], references: [id])
  employer              employer             @relation(fields: [employerId], references: [id])
  PagibigReportEntry    PagibigReportEntry[]

  @@index([employerId, applicableYear, applicableMonth])
  @@index([kind, createdAt])
}

model PagibigReportDraft {
  id              Int       @id @default(autoincrement())
  createdBy       Int
  kind            String
  employerId      Int?
  pin             String    @default("")
  applicableMonth Int       @default(1)
  applicableYear  Int
  entries         Json
  continuedBy     Int?
  continuedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  User            User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([continuedBy, updatedAt])
  @@index([createdBy, updatedAt])
}

model PagibigReportEntry {
  id                    Int           @id @default(autoincrement())
  reportId              Int
  employeeId            Int?
  employeeName          String
  employeeCode          String
  employeePagibigNumber String?
  employeeEmployerId    Int?
  employeeEmployerName  String?
  pagibigLoanId         Int?
  applicationNo         String?
  memberSavings         Decimal       @default(0) @db.Decimal(12, 2)
  modifiedSavings       Decimal       @default(0) @db.Decimal(12, 2)
  multiPurposeLoan      Decimal       @default(0) @db.Decimal(12, 2)
  calamityLoan          Decimal       @default(0) @db.Decimal(12, 2)
  safeLoan              Decimal       @default(0) @db.Decimal(12, 2)
  loanAmount            Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal       @db.Decimal(12, 2)
  ledgerSnapshot        Json?
  emergencyLoan         Decimal       @default(0) @db.Decimal(12, 2)
  employee              employee?     @relation(fields: [employeeId], references: [id])
  PagibigLoan           PagibigLoan?  @relation(fields: [pagibigLoanId], references: [id])
  PagibigReport         PagibigReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([employeeId, reportId])
  @@index([pagibigLoanId])
}

model OfficeContact {
  id          Int       @id @default(autoincrement())
  employeeId  Int?
  companyName String
  contactName String
  category    String
  phone       String?
  email       String?
  address     String?
  services    String?
  branch      String?
  notes       String?
  photoUrl    String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([category, active])
  @@index([companyName])
  @@index([employeeId])
}
