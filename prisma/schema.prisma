generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  password  String
  role      String   @default("USER")
  canAccessEmployees Boolean @default(false)
  emailVerified Boolean @default(true)
  verificationTokenHash String? @unique
  verificationTokenExpires DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
  tasks     Task[]
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      String   @default("PENDING")
  priority    String   @default("MEDIUM")
  category    String?
  dueDate     DateTime?
  sortOrder   Int      @default(0)
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model employee {
  id                Int       @id @default(autoincrement())
  status            String?
  dateStarted       DateTime?
  employerId        Int?
  address           String?
  age               Int?
  biometricNo       String?   @unique
  branch            String?
  position          String?
  createdAt         DateTime  @default(now())
  dateOfBirth       DateTime?
  email             String?
  emergencyAddress  String?
  emergencyName     String?
  emergencyNumber   String?
  emergencyRelation String?
  employeeCode      String    @unique
  endDate           DateTime?
  firstName         String
  gender            String?
  lastName          String
  maritalStatus     String?
  middleName        String?
  mobileNumber      String?
  pagIbigNumber     String?
  philHealth        String?
  photoUrl          String?
  remarks           String?
  sssNumber         String?
  tinNumber         String?
  updatedAt         DateTime  @updatedAt
  assignedBy        String?
  assignedAt        DateTime?
  employer          employer? @relation(fields: [employerId], references: [id])

  @@index([employerId])
}

model employer {
  id        Int        @id @default(autoincrement())
  name      String
  company   String?
  branches  String?
  status String @default("Active")
  email String?
  contactNumber String?
  branchStatus String @default("Open")
  president String?
  longAddress String?
  shortAddress String?
  logo String?
  secDti String?
  secDtiRegistrationDate DateTime?
  tin String?
  tinRegistrationDate DateTime?
  sss String?
  sssRegistrationDate DateTime?
  hdmf String?
  hdmfRegistrationDate DateTime?
  phic String?
  phicRegistrationDate DateTime?
  employees employee[]
}

model OfficeContact {
  id          Int      @id @default(autoincrement())
  companyName String
  contactName String
  category    String
  phone       String?
  email       String?
  address     String?
  services    String?
  branch      String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, active])
  @@index([companyName])
}
