generator client {
  provider = "prisma-client-js"
  output   = "../generated/sss-loans"
}

datasource db {
  provider = "postgresql"
  url      = env("SSS_LOANS_DATABASE_URL")
}

enum LoanProvider {
  SSS
  PAGIBIG
}

enum LoanStatus {
  ACTIVE
  INACTIVE
}

model SssReport {
  id                   Int              @id
  kind                 String
  employerId           Int
  employerName         String
  employerAddress      String?
  employerSssNumber    String?
  prn                  String
  applicableMonth      Int
  applicableYear       Int
  amountDue            Decimal          @db.Decimal(12, 2)
  amountPaid           Decimal?         @db.Decimal(12, 2)
  paymentType          String?
  payDate              DateTime?        @db.Date
  sssBranch            String?
  transactionReference String?
  createdBy            Int?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  entries              SssReportEntry[]

  @@index([employerId, applicableYear, applicableMonth])
  @@index([kind, createdAt])
}

model SssReportEntry {
  id                   Int       @id @default(autoincrement())
  reportId             Int
  employeeId           Int?
  employeeName         String
  employeeCode         String
  employeeSssNumber    String?
  sssLoanId            Int?
  loanAccountNumber    String?
  employeeEmployerId   Int?
  employeeEmployerName String?
  salaryRange          String?
  monthlySalaryCredit  Decimal?  @db.Decimal(12, 2)
  employeeSs           Decimal   @default(0) @db.Decimal(12, 2)
  employerSs           Decimal   @default(0) @db.Decimal(12, 2)
  employeeMpf          Decimal   @default(0) @db.Decimal(12, 2)
  employerMpf          Decimal   @default(0) @db.Decimal(12, 2)
  ec                   Decimal   @default(0) @db.Decimal(12, 2)
  loanAmount           Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal   @db.Decimal(12, 2)
  report               SssReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sssLoan              SssLoan?  @relation(fields: [sssLoanId], references: [id], onDelete: SetNull)

  @@index([employeeId, reportId])
  @@index([sssLoanId])
}

model SssReportDraft {
  id              Int      @id
  createdBy       Int
  kind            String
  employerId      Int?
  prn             String   @default("")
  applicableMonth Int      @default(1)
  applicableYear  Int
  amountDue       String   @default("")
  entries         Json
  continuedBy     Int?
  continuedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdBy, updatedAt])
  @@index([continuedBy, updatedAt])
}

model SssLoan {
  id                  Int                    @id @default(autoincrement())
  employerId          Int
  employeeId          Int?
  employeeName        String
  employeeCode        String
  biometricNo         String
  loanAccountNumber   String
  transactionNumber   String?
  loanType            String                 @default("S")
  loanDate            DateTime               @db.Date
  loanAmount          Decimal?               @db.Decimal(12, 2)
  monthlyAmortization Decimal                @db.Decimal(12, 2)
  status              String                 @default("ACTIVE")
  statusReason        String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  reportEntries       SssReportEntry[]

  @@index([employerId, loanDate])
  @@index([employeeId, loanDate])
}

model Loan {
  id                  String        @id @default(uuid())
  employeeId          Int?
  provider            LoanProvider
  loanType            String
  loanAccountNumber   String        @unique
  loanDate            DateTime?     @db.Date
  terms               Int?
  statusReason        String?
  totalAmount         Decimal?      @db.Decimal(12, 2)
  monthlyAmortization Decimal       @db.Decimal(12, 2)
  outstandingBalance  Decimal?      @db.Decimal(12, 2)
  status              LoanStatus    @default(ACTIVE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  payments            LoanPayment[]

  @@index([employeeId])
  @@index([provider, status])
}

model LoanPayment {
  id              String   @id @default(uuid())
  loanId          String
  payrollPeriodId String
  amountPaid      Decimal  @db.Decimal(12, 2)
  paymentDate     DateTime @db.Date
  source          String   @default("MANUAL_ENTRY")
  createdAt       DateTime @default(now())
  loan            Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, paymentDate])
}

model LoanMonitorReport {
  id                   String                   @id @default(uuid())
  applicableDate       DateTime                 @db.Date
  employerName         String?
  employerSssNumber    String?
  employerAddress      String?
  totalMonthly         Decimal                  @db.Decimal(14, 2)
  totalOutstanding     Decimal                  @db.Decimal(14, 2)
  prn                  String?
  paymentDate          DateTime?                @db.Date
  amountPaid           Decimal?                 @db.Decimal(14, 2)
  paymentBranch        String?
  transactionReference String?
  createdBy            Int?
  createdAt            DateTime                 @default(now())
  entries              LoanMonitorReportEntry[]

  @@index([applicableDate])
}

model LoanMonitorReportEntry {
  id                  String            @id @default(uuid())
  reportId            String
  loanId              String
  provider            String
  loanType            String
  loanAccountNumber   String
  employeeName        String
  loanDate            DateTime?         @db.Date
  terms               Int?
  totalAmount         Decimal           @db.Decimal(12, 2)
  monthlyAmortization Decimal           @db.Decimal(12, 2)
  outstandingBalance  Decimal           @db.Decimal(12, 2)
  status              String
  statusReason        String?
  employerName        String
  employerSssNumber   String?
  employerAddress     String?
  report              LoanMonitorReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model ImportedSssLoanReport {
  sourceReportId       Int                              @id
  sourceKind           String
  sourceEmployerId     Int
  employerName         String
  employerAddress      String?
  employerSssNumber    String?
  prn                  String
  applicableMonth      Int
  applicableYear       Int
  amountDue            Decimal                          @db.Decimal(12, 2)
  amountPaid           Decimal?                         @db.Decimal(12, 2)
  paymentType          String?
  payDate              DateTime?                        @db.Date
  sssBranch            String?
  transactionReference String?
  sourceCreatedBy      Int?
  sourceCreatedAt      DateTime                         @db.Timestamp(3)
  sourceUpdatedAt      DateTime                         @db.Timestamp(3)
  importedAt           DateTime                         @default(now())
  entries              ImportedSssLoanReportEntry[]

  @@index([sourceEmployerId, applicableYear, applicableMonth])
  @@index([importedAt])
}

model ImportedSssLoanReportEntry {
  sourceEntryId            Int                   @id
  sourceReportId           Int
  sourceEmployeeId         Int?
  employeeName             String
  employeeCode             String
  employeeSssNumber        String?
  sourceSssLoanId          Int?
  loanAccountNumber        String?
  sourceEmployeeEmployerId Int?
  employeeEmployerName     String?
  salaryRange              String?
  monthlySalaryCredit      Decimal?              @db.Decimal(12, 2)
  employeeSs               Decimal               @db.Decimal(12, 2)
  employerSs               Decimal               @db.Decimal(12, 2)
  employeeMpf              Decimal               @db.Decimal(12, 2)
  employerMpf              Decimal               @db.Decimal(12, 2)
  ec                       Decimal               @db.Decimal(12, 2)
  loanAmount               Decimal               @db.Decimal(12, 2)
  totalAmount              Decimal               @db.Decimal(12, 2)
  report                   ImportedSssLoanReport @relation(fields: [sourceReportId], references: [sourceReportId], onDelete: Cascade)

  @@index([sourceReportId])
  @@index([loanAccountNumber])
}
