prisma:query SELECT "public"."Task"."id", "public"."Task"."title", "public"."Task"."dueDate", "public"."Task"."status", "public"."Task"."isFlagged" FROM "public"."Task" WHERE ("public"."Task"."userId" = $1 AND "public"."Task"."status" IN ($2,$3) AND "public"."Task"."dueDate" >= $4 AND "public"."Task"."dueDate" <= $5) ORDER BY "public"."Task"."dueDate" ASC LIMIT $6 OFFSET $7
prisma:query SELECT "public"."employee"."id", "public"."employee"."firstName", "public"."employee"."lastName", "public"."employee"."branch", "public"."employee"."photoUrl", "public"."employee"."dateOfBirth" FROM "public"."employee" WHERE ("public"."employee"."dateOfBirth" IS NOT NULL AND "public"."employee"."status" IN ($1,$2,$3,$4)) OFFSET $5
